# ============================================================================
# ozmishop-com (vitrin) — ORTAM ŞABLONU
# ----------------------------------------------------------------------------
# `cp .env.example .env` ile başlayın ve boş bırakılan değerleri doldurun.
#
# İKİ DOSYA VARDIR:
#   .env        → ÜRETİM değerleri (Render / Vercel panosuna girilecek olanlar)
#   .env.local  → yalnızca YERELDE farklı olanlar; .env'ten SONRA yüklenir ve EZER
# İkisi de git'e girmez. Yerelde çalışmak için .env'te HİÇBİR ŞEYİ yorumlamayın —
# .env.local'e yalnızca değişen anahtarları yazmak yeterli.
#
# NOT: Vercel derlemesi sırasında API'ye istek atılır (generateStaticParams ve
# önbelleklenen veri). Bu yüzden ÖNCE API'yi Render'a kurun, sonra burayı deploy edin.
# ============================================================================

# Sunucu tarafı — NEXT_PUBLIC_ öneki YOK, tarayıcıya sızmaz.
# Render servisiniz açıldıktan sonra gerçek adresle güncelleyin:
API_BASE_URL=

# ozmishop-api'deki REVALIDATE_SECRET ile BİREBİR aynı olmalı.
REVALIDATE_SECRET=

# Kanonik adres. Yalnız https://ozmishop.com (lib/site.ts canonicalHost) VE
# Vercel'de Production ortamı İNDEKSLENİR; dev.ozmishop.com ve Preview'lar
# indekslenmez: robots.txt "Disallow: /", boş sitemap, noindex metası ve her
# yanıtta `X-Robots-Tag: noindex` (lib/site.ts isIndexable). www BURAYA
# YAZILMAZ — Vercel'de www → apex 308 yönlendirmesi kurulur.
# Değer derlemeye gömülür: değiştirince yeniden deploy edin. Production
# derlemesinde boş ya da https olmayan değer derlemeyi durdurur (next.config.ts).
NEXT_PUBLIC_SITE_URL=

# Kanonik alan adında bile indekslemeyi kapatmak için "false" yazın (örn. canlı
# alan adı açılmış ama site henüz yayına hazır değilken). Boş = açık.
SITE_INDEXABLE=

# R2 public alan adının YALNIZCA host kısmı — şemasız, /-siz, sondaki / yok.
# Örn. API'deki R2_PUBLIC_URL=https://pub-abc123.r2.dev ise buraya
# pub-abc123.r2.dev yazılır. next/image uzak görseli ancak burada listeliyse
# yükler; boşken R2'den gelen her görsel 400 döner.
R2_PUBLIC_HOSTNAME=

# Google Analytics 4 ölçüm kimliği (G-XXXXXXX). BOŞSA hiçbir analitik kod
# yüklenmez ve çerez bandında analitik seçeneği çıkmaz. Yalnız Vercel
# Production'da canlı kimlik; Preview'da ayrı test kimliği ya da boş.
# Açmadan önce çerez politikası güncellenmeli: docs/analitik-olaylari.md.
NEXT_PUBLIC_GA_ID=
# 1: GA4 DebugView'da görünür (debug_mode). Canlıda boş.
NEXT_PUBLIC_GA_DEBUG=

# ozmishop-api ve ozmishop-admin ile AYNI değer.
TRUSTED_PROXY_SECRET=

# Anasayfa önizlemesini iframe'e alabilecek kaynak(lar).
# CSP frame-ancestors birden çok kaynağı BOŞLUKLA ayırarak kabul eder; panel
# hem vercel.app hem özel alan adından açılıyorsa İKİSİNİ DE yazın, yoksa
# yazılmayan adresten önizleme boş görünür.
ADMIN_BASE_URL=


# ============================================================================
# ÖRNEK .env.local — yerel geliştirme. Bu bloğu `.env.local` dosyasına KOPYALAYIN.
# ----------------------------------------------------------------------------
# API_BASE_URL=http://localhost:4200
# NEXT_PUBLIC_SITE_URL=http://localhost:3201
# ADMIN_BASE_URL=http://localhost:3100
# REVALIDATE_SECRET=dev-revalidate-secret
# TRUSTED_PROXY_SECRET=dev-bff-secret
# R2_PUBLIC_HOSTNAME=      ← .env'deki ile AYNI: yerelde de medya R2'den gelir
# ============================================================================
