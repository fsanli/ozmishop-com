# Sunucu tarafı — tarayıcıya sızmaz (NEXT_PUBLIC_ öneki yok)
API_BASE_URL=http://localhost:4200

# ozmishop-api ile birebir aynı olmalı (POST /api/revalidate)
REVALIDATE_SECRET=change-me-too

# Kanonik adres: robots.ts yalnızca bu alan adında taramaya izin verir
NEXT_PUBLIC_SITE_URL=http://localhost:3201

# R2 public alan adı (next/image için); boşsa yalnızca localhost:4200 görselleri açılır
R2_PUBLIC_HOSTNAME=

# ozmishop-api ile AYNI değer olmalı (hız sınırının gerçek istemci IP’sini görmesi için).
TRUSTED_PROXY_SECRET=

# Anasayfa önizlemesini iframe'e alabilecek tek kaynak (panel adresi).
ADMIN_BASE_URL=http://localhost:3100
